{
  "name": "strata-desktop",
  "productName": "Strata",
  "version": "0.1.0",
  "description": "Strata's chat page in its own window, with a tray icon and the model started and stopped for you.",
  "main": "main.js",
  "private": true,
  "author": "Strata",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.strata.desktop",
    "productName": "Strata",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "loading.html", "build/icon.png", "package.json"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Strata-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Strata-${version}-portable.${ext}"
    }
  }
}
